<span class="contact-glass" data-contact-glass data-filled="false" aria-hidden="true">
  <svg viewBox="0 0 44 44" fill="none" focusable="false" aria-hidden="true">
    <defs><clipPath id="contact-glass-inside"><path d="M14 13h16l-2.3 23H16.3L14 13Z" /></clipPath></defs>
    <path class="contact-glass-fill" d="M13 16h18v22H13z" fill="#b7791f" clip-path="url(#contact-glass-inside)" />
    <path d="M12 10h20l-2.5 27h-15L12 10Z" stroke="#4e5144" stroke-width="1.3" />
    <path d="M10 10h24M17 37h10M17 7h10" stroke="#8b877b" stroke-width="1" />
    <path d="M8 22h4m20 0h4M22 3v4" stroke="#b9b3a4" stroke-width="1" />
  </svg>
</span>

<script>
  const drawing = document.querySelector<HTMLElement>('[data-contact-glass]');
  if (drawing) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = drawing.className;
    button.dataset.contactGlass = '';
    button.dataset.filled = 'false';
    button.setAttribute('aria-label', 'Fill glass');
    button.setAttribute('aria-pressed', 'false');
    button.append(...drawing.childNodes);
    drawing.replaceWith(button);
    button.addEventListener('click', () => {
      const filled = button.dataset.filled !== 'true';
      button.dataset.filled = String(filled);
      button.setAttribute('aria-pressed', String(filled));
      button.setAttribute('aria-label', filled ? 'Empty glass' : 'Fill glass');
    });
  }
</script>

<style is:global>
  [data-contact-glass] { display: inline-grid; place-items: center; width: 44px; height: 44px; flex: none; padding: 0; }
  button[data-contact-glass] { border: 0; background: transparent; color: inherit; cursor: pointer; }
  [data-contact-glass] svg { width: 44px; height: 44px; }
  [data-contact-glass] .contact-glass-fill { transform: scaleY(0); transform-origin: 50% 100%; transition: transform 220ms ease-out; }
  [data-contact-glass][data-filled="true"] .contact-glass-fill { transform: scaleY(1); }
  @media (prefers-reduced-motion: reduce) { [data-contact-glass] .contact-glass-fill { transition: none; } }
</style>
