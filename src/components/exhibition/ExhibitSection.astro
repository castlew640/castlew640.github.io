---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StopSection from './StopSection.astro';
import ExhibitDrawing from './drawings/ExhibitDrawing.astro';
import { evidenceFit, imageSize } from '../../lib/evidence-fit';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { slug } = project.data;
const clientData = project.data.kind === 'client' ? project.data : undefined;
const personalData = project.data.kind === 'personal' ? project.data : undefined;
const shot = clientData ? clientData.screenshots[0] : personalData!.evidence[0];
const evidenceKind = clientData ? 'screenshot' : personalData!.evidence[0].kind;
const requestedFit = clientData ? 'cover' : personalData!.evidence[0].fit;
const resolvedFit = evidenceFit(evidenceKind, requestedFit, shot.src.width, shot.src.height);
const panel = await getImage({ src: shot.src, ...imageSize(shot.src.width, shot.src.height), format: 'webp' });
const labels = {
  website: 'Website',
  'manual-planner': 'Manual Wi-Fi planner',
  'ai-mvp': 'AI planner MVP',
};
---

<StopSection id={`exhibit-${slug}`} slug={slug} labelledBy={`exhibit-${slug}-title`}>
  <figure data-panel-source data-evidence-kind={evidenceKind} data-evidence-fit={resolvedFit}>
    <img src={panel.src} width={panel.attributes.width} height={panel.attributes.height} alt={shot.alt} decoding="async" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} data-evidence-fit={resolvedFit} />
    <figcaption>{shot.caption}</figcaption>
  </figure>
  <ExhibitDrawing variant={index} />
  <div class="exhibit-overlay">
    <p class="eyebrow">Exhibit {String(index + 1).padStart(2, '0')}</p>
    <h2 class="exhibit-title" id={`exhibit-${slug}-title`}>{project.data.title}</h2>
    <p class="exhibit-summary">{project.data.summary}</p>
    {clientData ? (
      <ul class="contract-labels">
        {clientData.contracts.map((contract) => <li>{labels[contract.id]}</li>)}
      </ul>
    ) : (
      <ul class="contract-labels"><li>{personalData!.format === 'deep-dive' ? 'Technical deep dive' : personalData!.format === 'showcase' ? 'Project showcase' : 'Case study'}</li></ul>
    )}
    <a class="text-link exhibit-link" href={`/projects/${slug}/`}>Read case study <span>→</span></a>
  </div>
</StopSection>
