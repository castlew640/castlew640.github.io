---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { evidenceFit, imageSize } from '../../lib/evidence-fit';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const client = data.kind === 'client';
const items = client
  ? data.screenshots.map((item) => ({ ...item, kind: 'screenshot' as const, fit: 'cover' as const }))
  : data.evidence;
const evidence = await Promise.all(items.map(async (item) => ({
  ...item,
  fit: evidenceFit(item.kind, item.fit, item.src.width, item.src.height),
  optimized: await getImage({ src: item.src, ...imageSize(item.src.width, item.src.height), format: 'webp' }),
})));
const shortTitle = data.title.split(' — ')[0];
const formatLabel = { 'case-study': 'Case study', showcase: 'Project showcase', 'deep-dive': 'Technical deep dive' }[data.format];
const titleId = `viewer-${data.slug}-title`;
---

<dialog class="exhibit-viewer" id={`viewer-${data.slug}`} data-exhibit-viewer={data.slug} aria-labelledby={titleId}>
  <button type="button" class="viewer-close" data-viewer-close aria-label="Close the exhibit">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
  </button>
  <div class="viewer-layout">
    <div class="viewer-gallery">
      <div class="viewer-track" data-viewer-track role="group" aria-label={`${shortTitle} screenshots`} tabindex="0">
        {evidence.map((item, slide) => (
          <figure class="viewer-slide" data-viewer-slide data-evidence-fit={item.fit} aria-roledescription="slide" aria-label={`${slide + 1} of ${evidence.length}`}>
            <div class="viewer-image"><img src={item.optimized.src} width={item.optimized.attributes.width} height={item.optimized.attributes.height} alt={item.alt} loading="lazy" decoding="async" /></div>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
      {evidence.length > 1 && (
        <div class="viewer-steps">
          <button type="button" data-viewer-step="-1" aria-label="Previous screenshot"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg></button>
          <span class="viewer-count" data-viewer-count aria-live="polite">1 / {evidence.length}</span>
          <button type="button" data-viewer-step="1" aria-label="Next screenshot"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg></button>
        </div>
      )}
    </div>
    <div class="viewer-info">
      <p class="eyebrow">Exhibit {String(index + 1).padStart(2, '0')} · {client ? 'Client work' : formatLabel}</p>
      <h2 id={titleId}>{data.title}</h2>
      <p class="viewer-summary">{data.summary}</p>
      {data.kind === 'client' && (
        <ol class="viewer-contracts" aria-label="Three separate contracts">
          {data.contracts.map((contract) => (
            <li>
              <h3>{contract.title}</h3>
              <p>{contract.description}</p>
              <p class="contract-meta">{contract.hosting}</p>
            </li>
          ))}
        </ol>
      )}
      <div class="viewer-actions">
        <a class="viewer-primary" href={`/projects/${data.slug}/`}>Read the full case study <span aria-hidden="true">→</span></a>
        {data.liveUrl && <a class="text-link" href={data.liveUrl}>Visit {client ? shortTitle : 'the live site'} <span aria-hidden="true">↗</span></a>}
        {data.repositoryUrl && <a class="text-link" href={data.repositoryUrl}>View repository <span aria-hidden="true">↗</span></a>}
        <button type="button" class="viewer-back" data-viewer-close>Back to the exhibition</button>
      </div>
    </div>
  </div>
</dialog>
