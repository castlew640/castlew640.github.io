---
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** The home exhibition chooses its view before first paint to avoid a layout flash. */
  exhibition?: boolean;
}

const {
  title = `${profile.displayName} — Software & solutions`,
  description = profile.introduction,
  exhibition = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const destinations = ['Projects', 'About', 'Resume', 'Contact'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    {exhibition && (
      <script is:inline>
        // Mirrors policy.ts: an explicit choice wins, then reduced motion, the
        // phone default, then graphics drawn without hardware acceleration.
        (() => {
          const root = document.documentElement;
          let choice = null;
          try { choice = localStorage.getItem('exhibition-view'); } catch { /* storage blocked */ }
          if (choice === 'still' || choice === 'moving') { root.dataset.view = choice; return; }
          const reason = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced-motion'
            : matchMedia('(max-width: 767px), (pointer: coarse) and (max-height: 480px)').matches ? 'phone' : '';
          if (reason) { root.dataset.view = 'still'; root.dataset.viewReason = reason; return; }
          let software = false;
          try {
            const gl = document.createElement('canvas').getContext('webgl2') || document.createElement('canvas').getContext('webgl');
            if (gl) {
              const info = gl.getExtension('WEBGL_debug_renderer_info');
              software = /swiftshader|llvmpipe|softpipe|software|basic render/i.test(String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER)));
              const lose = gl.getExtension('WEBGL_lose_context');
              if (lose) lose.loseContext();
            }
          } catch { /* the scene reports its own failure */ }
          root.dataset.graphics = software ? 'software' : 'hardware';
          root.dataset.view = software ? 'still' : 'moving';
          if (software) root.dataset.viewReason = 'graphics';
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-frame">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${profile.displayName}, home`}>
          <span class="monogram" aria-hidden="true">W<span>/</span>C</span>
          <span class="wordmark-caption">Software &amp; solutions.</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          {destinations.map((name) => <a href={`/#${name.toLowerCase()}`}>{name}</a>)}
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <span>{profile.displayName}</span>
        <span>Plans becoming places.</span>
        <a href="#main">Back to the beginning <span aria-hidden="true">↑</span></a>
      </footer>
    </div>
  </body>
</html>
