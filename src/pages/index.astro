---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout>
  <section class="introduction" aria-labelledby="introduction-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="registration-mark" aria-hidden="true">+</span> A portfolio of things taking shape</p>
      <h1 id="introduction-title">{profile.displayName}</h1>
      <p class="introduction-copy">{profile.introduction}</p>
      <a class="text-link" href="#projects">Explore the work <span aria-hidden="true">↘</span></a>
    </div>

    <div class="architectural-study" aria-hidden="true">
      <div class="drawing-label"><span>Fig. 01</span><span>From a line, a possibility.</span></div>
      <svg viewBox="0 0 520 590" fill="none" focusable="false">
        <defs>
          <pattern id="construction-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
            <path d="M0 0V7" stroke="#8e4935" stroke-width="1" />
          </pattern>
        </defs>
        <g stroke="#b9b3a4" stroke-width="1">
          <path d="M18 475H502M54 46V529M456 38V535M18 170H493M13 541H503" />
          <path d="M20 573 450 325M74 584 480 350M24 375 469 585" stroke-dasharray="4 7" />
          <path d="M47 39h14m-7-7v14M449 39h14m-7-7v14M47 541h14m-7-7v14M449 541h14m-7-7v14" stroke="#656256" />
          <path d="M22 186v273m-5-273h10m-10 273h10M113 565h265m-265-5v10m265-10v10" />
        </g>
        <circle cx="363" cy="141" r="82" fill="#e3d8bc" />
        <circle cx="363" cy="141" r="106" stroke="#b9b3a4" stroke-dasharray="2 6" />
        <g stroke="#8b877b" stroke-width="1.3" stroke-dasharray="5 5">
          <path d="M73 466V213a95 95 0 0 1 190 0v253M99 466V213a69 69 0 0 1 138 0v253" />
          <path d="m73 466 51-29m139 29 51-29M124 437V184a95 95 0 0 1 190 0v253" />
          <path d="m73 213 51-29m139 29 51-29M168 118l51-29" />
        </g>
        <path d="m162 479 154-89 158 90-154 89z" fill="#e4dece" />
        <path d="m196 459 108-62 113 65-108 62z" fill="#c2baa6" />
        <path d="M170 465V252a107 107 0 0 1 214 0v213l-37 22V274a107 107 0 0 0-214 0v213z" fill="#d2c9b5" stroke="#4e5144" stroke-width="1.3" />
        <path d="M133 487V274a107 107 0 0 1 214 0v213h-38V274a69 69 0 0 0-138 0v213z" fill="#ece6d6" stroke="#4e5144" stroke-width="1.4" />
        <path d="M171 487V274a69 69 0 0 1 138 0v213l37-22V252a69 69 0 0 0-138 0v213z" fill="#a65e46" stroke="#4e5144" stroke-width="1.2" />
        <path d="M171 487V274a69 69 0 0 1 138 0v213l37-22V252a69 69 0 0 0-138 0v213z" fill="url(#construction-hatch)" />
        <path d="M208 465V274a69 69 0 0 1 101-61v274z" fill="#f4f0e6" />
        <path d="M208 465V274a69 69 0 0 1 101-61" stroke="#4e5144" stroke-width="1.2" />
        <path d="m171 487 37-22m101 22 37-22M240 167l37-22M133 274l37-22" stroke="#4e5144" stroke-width="1.2" />
        <g stroke="#6e745d" stroke-width="1.4">
          <path d="m342 522 64-37 30 17-64 37zM372 539v13l64-37v-13M342 522v13l30 17M354 506l64-37 18 10-64 37zM372 516v10l64-37v-10" fill="#d4d7c4" />
        </g>
        <path d="M418 255v71m-8-10 8 10 8-10" stroke="#8e4935" stroke-width="1.4" />
        <circle cx="78" cy="508" r="3" fill="#8e4935" />
        <path d="M88 508h39" stroke="#8e4935" />
      </svg>
      <p class="drawing-caption"><span>Study in becoming</span><span>Drawing → structure</span></p>
    </div>

    <div class="hero-footnote"><span>Ideas, considered. Software, delivered.</span><span aria-hidden="true">↓</span></div>
  </section>

  <section id="projects" class="catalogue-section" aria-labelledby="projects-title">
    <div class="section-heading"><p class="eyebrow">01 / The work</p><h2 id="projects-title">Projects</h2></div>
    <div class="section-body project-publication-note">
      <p class="editorial-title">A client story,<br /><em>taking shape.</em></p>
      <p>The case study and its approved evidence are being prepared for this catalogue.</p>
      <p class="publication-status"><span aria-hidden="true">○</span> Case study awaiting publication</p>
    </div>
  </section>

  <section id="about" class="catalogue-section" aria-labelledby="about-title">
    <div class="section-heading"><p class="eyebrow">02 / The person</p><h2 id="about-title">About</h2></div>
    <div class="section-body">
      <p class="large-copy">{profile.background}</p>
      <p>I was the sole developer across those engagements. My work starts with understanding the client’s goal, then making practical decisions about what to build and how to deliver it.</p>
    </div>
  </section>

  <section id="resume" class="catalogue-section" aria-labelledby="resume-title">
    <div class="section-heading"><p class="eyebrow">03 / The background</p><h2 id="resume-title">Resume</h2></div>
    <div class="section-body">
      {profile.resumeUrl ? (
        <a class="text-link" href={profile.resumeUrl}>Open my resume <span aria-hidden="true">↗</span></a>
      ) : (
        <>
          <p class="large-copy">Public edition pending.</p>
          <p>The public version of my resume hasn’t been selected yet. In the meantime, you can reach me directly by email.</p>
          <a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↘</span></a>
        </>
      )}
    </div>
  </section>

  <section id="contact" class="catalogue-section contact-section" aria-labelledby="contact-title">
    <div class="section-heading"><p class="eyebrow">04 / A conversation</p><h2 id="contact-title">Contact</h2></div>
    <div class="section-body">
      <p class="editorial-title">What could we<br /><em>build together?</em></p>
      <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a>
      <ul class="profile-links" aria-label="Find me elsewhere">
        {profile.profileLinks.map(({ label, url }) => <li><a class="text-link" href={url}>{label} <span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
