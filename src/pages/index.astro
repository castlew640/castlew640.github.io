---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitionShell from '../components/exhibition/ExhibitionShell.astro';
import StopSection from '../components/exhibition/StopSection.astro';
import ExhibitSection from '../components/exhibition/ExhibitSection.astro';
import ExhibitViewer from '../components/exhibition/ExhibitViewer.astro';
import PersistenceDrawing from '../components/exhibition/drawings/PersistenceDrawing.astro';
import LipsDrawing from '../components/exhibition/drawings/LipsDrawing.astro';
import LandingDrawing from '../components/exhibition/drawings/LandingDrawing.astro';
import ContactGlass from '../components/ContactGlass.astro';
import { profile } from '../data/profile';
import { getPublishedProjects } from '../lib/projects';

const projects = await getPublishedProjects();
---

<BaseLayout exhibition>
  <!-- Rendered up front and revealed before first paint, so the notice never shifts the page. -->
  <p class="view-notice" data-view-notice>
    <span data-reason="phone">Illustrated still view is on. You can enter the 3D exhibition.</span>
    <span data-reason="reduced-motion">Still view is on because your device requests reduced motion.</span>
    <span data-reason="graphics">Illustrated still view is on because this browser draws 3D without graphics acceleration. You can still enter the 3D exhibition.</span>
  </p>
  <ExhibitionShell>
  <StopSection id="entrance" class="introduction" labelledBy="introduction-title" name="Entrance">
    <div class="placard placard-hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="registration-mark" aria-hidden="true">+</span> A portfolio of things taking shape</p>
        <h1 id="introduction-title">{profile.displayName}</h1>
        <p class="introduction-copy">{profile.introduction}</p>
        <div class="hero-actions">
          <a class="text-link" href="#projects">Explore the work <span aria-hidden="true">↘</span></a>
          <p class="hero-hint">Scroll, swipe, or tap anything that catches your eye.</p>
        </div>
      </div>
    </div>
    <div class="hero-illustration"><PersistenceDrawing /></div>
  </StopSection>

  <section id="projects" class="catalogue-section" aria-labelledby="projects-title">
    <div class="section-heading"><p class="eyebrow">01 / The work</p><h2 id="projects-title">Projects</h2></div>
    {projects.length > 0 ? (
      <div class="exhibit-list">
        {projects.map((project, index) => <ExhibitSection project={project} index={index} />)}
      </div>
    ) : (
      <div class="section-body">
        <h3>The exhibition is still under construction.</h3>
        <p>No projects are published yet. You can still read about William Castle, open his resume, and get in touch below.</p>
      </div>
    )}
  </section>

  <StopSection id="about" class="catalogue-section" labelledBy="about-title" name="About" title="About">
    <div class="placard placard-about">
      <div class="section-heading"><p class="eyebrow">02 / The person</p><h2 id="about-title">About</h2></div>
      <div class="section-body">
        <p class="large-copy">{profile.background}</p>
        {profile.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <LipsDrawing />
  </StopSection>

  <StopSection id="landing" labelledBy="resume-title contact-title" name="Resume & contact" title="Resume & contact">
  <LandingDrawing />
  <div class="placard placard-landing">
  <section id="resume" class="catalogue-section" aria-labelledby="resume-title">
    <div class="section-heading"><p class="eyebrow">03 / The background</p><h2 id="resume-title">Resume</h2></div>
    <div class="section-body">
      <p class="large-copy">A concise record of my work and education.</p>
      <a class="text-link" href={profile.resumeUrl}>Open my resume <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="contact" class="catalogue-section contact-section" aria-labelledby="contact-title">
    <div class="section-heading"><p class="eyebrow">04 / A conversation</p><div class="contact-title-row"><h2 id="contact-title">Talk shop with me.</h2><ContactGlass /></div></div>
    <div class="section-body">
      <p class="landing-invitation">Have a problem worth untangling? I’d like to hear about it.</p>
      <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a>
      <ul class="profile-links" aria-label="Find me elsewhere">
        {profile.profileLinks.map(({ label, url }) => <li><a class="text-link" href={url}>{label} <span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </div>
  </section>
  </div>
  </StopSection>
  </ExhibitionShell>
  {projects.map((project, index) => <ExhibitViewer project={project} index={index} />)}
</BaseLayout>
